{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://example.com/#website",
      "url": "https://example.com/",
      "name": "ФОРМА",
      "inLanguage": "ru-RU"
    },
    {
      "@type": "CheckoutPage",
      "@id": "https://example.com/checkout.html#webpage",
      "url": "https://example.com/checkout.html",
      "name": "Оформление заказа",
      "inLanguage": "ru-RU",
      "isPartOf": {
        "@id": "https://example.com/#website"
      },
      "breadcrumb": {
        "@id": "https://example.com/checkout.html#breadcrumbs"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://example.com/checkout.html#breadcrumbs",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Главная",
          "item": "https://example.com/index.html"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Корзина",
          "item": "https://example.com/cart.html"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Оформление заказа",
          "item": "https://example.com/checkout.html"
        }
      ]
    }
  ]
}